{
  "datasets": [
    {
      "name": "risk_distribution",
      "displayName": "Risk Distribution",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 'CRÍTICO - Menos de 7 días'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 15 THEN 'ALTO - 7-15 días'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 30 THEN 'MEDIO - 15-30 días'\n",
        "    ELSE 'BAJO - Más de 30 días'\n",
        "  END as nivel_riesgo,\n",
        "  COUNT(*) as cantidad_sitios\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  1"
      ]
    },
    {
      "name": "department_risk_analysis",
      "displayName": "Department Risk Analysis",
      "queryLines": [
        "SELECT\n",
        "  DEPARTAMENTO,\n",
        "  COUNT(*) as total_sitios,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as sitios_criticos,\n",
        "  ROUND(AVG(TRY_CAST(`SALDO DIAS` AS DOUBLE)), 1) as cobertura_promedio_dias,\n",
        "  SUM(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)) as inventario_total\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  DEPARTAMENTO\n",
        "ORDER BY\n",
        "  sitios_criticos DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "executive_kpis",
      "displayName": "Executive KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT cncodpus) as total_sites_monitored,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as sites_critical_risk,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN `ACCIÓN` = 'REABASTECER' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as sites_requiring_action,\n",
        "  ROUND(SUM(TRY_CAST(`PPTO TRANSP` AS DOUBLE)) / 1000000, 2) as total_budget_millions_cop\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'"
      ]
    },
    {
      "name": "urgent_action_queue",
      "displayName": "Urgent Action Queue",
      "queryLines": [
        "SELECT\n",
        "  cncodpus,\n",
        "  DEPARTAMENTO,\n",
        "  MUNICIPIO,\n",
        "  `SEDE ROLLOS` as sede_origen,\n",
        "  TRY_CAST(`SALDO DIAS` AS DOUBLE) as dias_cobertura,\n",
        "  ABS(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)) as rollos_requeridos,\n",
        "  TRY_CAST(`PPTO TRANSP` AS DOUBLE) as costo_transporte,\n",
        "  DATE_ADD(\n",
        "    CURRENT_DATE(),\n",
        "    CAST(TRY_CAST(`SALDO DIAS` AS DOUBLE) AS INT)\n",
        "  ) as fecha_estimada_desabastecimiento\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND `ACCIÓN` = 'REABASTECER'\n",
        "  AND TRY_CAST(`SALDO DIAS` AS DOUBLE) < 30\n",
        "ORDER BY\n",
        "  dias_cobertura ASC\n",
        "LIMIT 50"
      ]
    },
    {
      "name": "coverage_trend",
      "displayName": "Coverage Trend by Department",
      "queryLines": [
        "SELECT\n",
        "  DEPARTAMENTO,\n",
        "  ROUND(AVG(TRY_CAST(`SALDO DIAS` AS DOUBLE)), 1) as cobertura_promedio_dias,\n",
        "  ROUND(AVG(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)), 1) as promedio_rollos,\n",
        "  30 as stock_seguridad_dias,\n",
        "  COUNT(*) as total_pus,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as pus_criticos\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND TRY_CAST(`SALDO DIAS` AS DOUBLE) IS NOT NULL\n",
        "GROUP BY\n",
        "  DEPARTAMENTO\n",
        "ORDER BY\n",
        "  cobertura_promedio_dias ASC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "coverage_by_typology",
      "displayName": "Coverage by Typology",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) <= 0 THEN 'DESABASTECIDO'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) <= 5 THEN '1-5 D'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) <= 10 THEN '6-10 D'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) <= 15 THEN '11-15 D'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) <= 30 THEN '16-30 D'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) <= 60 THEN '31-60 D'\n",
        "    ELSE '60+ D'\n",
        "  END as rango_cobertura,\n",
        "  COALESCE(`TIPOLOGIA OPERACIONES`, 'NO_DEFINIDO') as tipologia_operaciones,\n",
        "  COUNT(*) as cantidad_pus\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  1,\n",
        "  2"
      ]
    },
    {
      "name": "scatter_consumption",
      "displayName": "Scatter Coverage vs Stock",
      "queryLines": [
        "SELECT\n",
        "  cncodpus,\n",
        "  TRY_CAST(`SALDO DIAS` AS DOUBLE) as saldo_dias,\n",
        "  TRY_CAST(`SALDO ROLLOS` AS DOUBLE) as saldo_rollos,\n",
        "  DEPARTAMENTO,\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 'CRITICO'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 30 THEN 'ALTO'\n",
        "    ELSE 'BAJO'\n",
        "  END as nivel_riesgo\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND TRY_CAST(`SALDO ROLLOS` AS DOUBLE) IS NOT NULL\n",
        "  AND TRY_CAST(`SALDO DIAS` AS DOUBLE) IS NOT NULL\n",
        "LIMIT 5000"
      ]
    },
    {
      "name": "dispatch_matrix",
      "displayName": "Dispatch Matrix",
      "queryLines": [
        "SELECT\n",
        "  cncodpus,\n",
        "  `SEDE ROLLOS` as sede_rollos,\n",
        "  DEPARTAMENTO,\n",
        "  MUNICIPIO,\n",
        "  `TIPOLOGIA OPERACIONES` as tipologia_operaciones,\n",
        "  TRY_CAST(`SALDO ROLLOS` AS DOUBLE) as saldo_rollos,\n",
        "  TRY_CAST(`SALDO DIAS` AS DOUBLE) as saldo_dias,\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO ROLLOS` AS DOUBLE) <= 0 THEN 'DESABASTECIDO'\n",
        "    WHEN TRY_CAST(`SALDO ROLLOS` AS DOUBLE) < 30 THEN 'CRITICO'\n",
        "    ELSE 'ABASTECIDO'\n",
        "  END as estado_inventario,\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO ROLLOS` AS DOUBLE) <= 0 THEN 'DESPACHO INMEDIATO'\n",
        "    WHEN TRY_CAST(`SALDO ROLLOS` AS DOUBLE) < 30 THEN 'PEDIDO PREVENTIVO'\n",
        "    ELSE 'MONITOREO'\n",
        "  END as sugerencia_accion,\n",
        "  TRY_CAST(`PPTO TRANSP` AS DOUBLE) as ppto_transp\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "ORDER BY\n",
        "  saldo_rollos ASC"
      ]
    },
    {
      "name": "dispatch_urgency_by_dept",
      "displayName": "Dispatch Urgency by Department",
      "queryLines": [
        "SELECT\n",
        "  DEPARTAMENTO,\n",
        "  COUNT(*) as urgent_sites_count\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND (\n",
        "    TRY_CAST(`SALDO ROLLOS` AS DOUBLE) <= 0\n",
        "    OR `SALDO ROLLOS` IS NULL\n",
        "  )\n",
        "GROUP BY\n",
        "  DEPARTAMENTO\n",
        "ORDER BY\n",
        "  urgent_sites_count DESC\n",
        "LIMIT 15"
      ]
    }
  ],
