{
  "datasets": [
    {
      "name": "cobertura_promedio",
      "displayName": "Cobertura Promedio Nacional",
      "queryLines": [
        "SELECT\n",
        "  ROUND(AVG(TRY_CAST(`SALDO DIAS` AS DOUBLE)), 1) as cobertura_promedio_dias\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'"
      ]
    },
    {
      "name": "kpis_financieros",
      "displayName": "KPIs Financieros Globales",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT cncodpus) as pus_activos,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 0 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as pus_desabastecidos,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN `ACCIÓN` = 'REABASTECER' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as pus_reabastecer,\n",
        "  ROUND(SUM(TRY_CAST(`PPTO TRANSP` AS DOUBLE)) / 1000000, 2) as presupuesto_total_asignado\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'"
      ]
    },
    {
      "name": "top_departamentos",
      "displayName": "Top 15 Departamentos Críticos",
      "queryLines": [
        "SELECT\n",
        "  DEPARTAMENTO,\n",
        "  SUM(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)) as saldo_total,\n",
        "  COUNT(cncodpus) as total_pus,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as pus_criticos\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  DEPARTAMENTO\n",
        "ORDER BY\n",
        "  pus_criticos DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "scatter_consumo_cobertura",
      "displayName": "Relación Consumo vs Cobertura",
      "queryLines": [
        "SELECT\n",
        "  cncodpus,\n",
        "  prom_mensual as consumo_mensual,\n",
        "  TRY_CAST(`SALDO DIAS` AS DOUBLE) as cobertura_dias,\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 'CRÍTICO'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 15 THEN 'ALTO'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 30 THEN 'MEDIO'\n",
        "    ELSE 'BAJO'\n",
        "  END as riesgo_desabastecimiento\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND prom_mensual IS NOT NULL"
      ]
    },
    {
      "name": "alertas_reabastecimiento",
      "displayName": "Top 30 Alertas Reabastecimiento",
      "queryLines": [
        "SELECT\n",
        "  ROW_NUMBER() OVER (ORDER BY TRY_CAST(`SALDO DIAS` AS DOUBLE) ASC) as ranking_prioridad,\n",
        "  cncodpus,\n",
        "  DEPARTAMENTO,\n",
        "  MUNICIPIO,\n",
        "  `SEDE ROLLOS` as sede,\n",
        "  TRY_CAST(`SALDO DIAS` AS DOUBLE) as cobertura_dias,\n",
        "  ABS(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)) as rollos_requeridos,\n",
        "  ROUND(TRY_CAST(`PPTO TRANSP` AS DOUBLE), 2) as costo_cop,\n",
        "  DATE_ADD(\n",
        "    CURRENT_DATE(),\n",
        "    CAST(TRY_CAST(`SALDO DIAS` AS DOUBLE) AS INT)\n",
        "  ) as fecha_estimada_desabastecimiento\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND `ACCIÓN` = 'REABASTECER'\n",
        "  AND TRY_CAST(`SALDO DIAS` AS DOUBLE) < 30\n",
        "ORDER BY\n",
        "  cobertura_dias ASC\n",
        "LIMIT 30"
      ]
    },
    {
      "name": "resumen_inventario_sede",
      "displayName": "Resumen Inventario por Sede",
      "queryLines": [
        "SELECT\n",
        "  `SEDE ROLLOS` as sede,\n",
        "  COUNT(cncodpus) as total_pus,\n",
        "  SUM(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)) as stock_total_rollos,\n",
        "  ROUND(AVG(TRY_CAST(`SALDO DIAS` AS DOUBLE)), 1) as cobertura_promedio_dias,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN `ACCIÓN` = 'REABASTECER' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as pus_requieren_reabastecimiento,\n",
        "  ROUND(SUM(TRY_CAST(`PPTO TRANSP` AS DOUBLE)) / 1000000, 2) as presupuesto_asignado_millones\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  `SEDE ROLLOS`\n",
        "ORDER BY\n",
        "  pus_requieren_reabastecimiento DESC"
      ]
    },
    {
      "name": "pct_desabastecidos",
      "displayName": "Porcentaje Desabastecidos",
      "queryLines": [
        "WITH kpis AS (\n",
        "  SELECT\n",
        "    COUNT(DISTINCT cncodpus) as pus_activos,\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 0 THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    ) as pus_desabastecidos\n",
        "  FROM\n",
        "    proyecto1.default.modelo_bigdata_raw\n",
        "  WHERE\n",
        "    `ESTADO PUNTO` = 'ACTIVO'\n",
        ")\n",
        "SELECT\n",
        "  ROUND((pus_desabastecidos * 100.0 / pus_activos), 2) as pct_desabastecidos\n",
        "FROM\n",
        "  kpis"
      ]
    },
    {
      "name": "distribucion_riesgo",
      "displayName": "Distribución de Niveles de Riesgo",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 'CRÍTICO'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 15 THEN 'ALTO'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 30 THEN 'MEDIO'\n",
        "    ELSE 'BAJO'\n",
        "  END as nivel_riesgo,\n",
        "  COUNT(cncodpus) as cantidad\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN nivel_riesgo = 'CRÍTICO' THEN 1\n",
        "    WHEN nivel_riesgo = 'ALTO' THEN 2\n",
        "    WHEN nivel_riesgo = 'MEDIO' THEN 3\n",
        "    ELSE 4\n",
        "  END"
      ]
    },
    {
      "name": "top_municipios",
      "displayName": "Top 10 Municipios Críticos",
      "queryLines": [
        "SELECT\n",
        "  DEPARTAMENTO,\n",
        "  MUNICIPIO,\n",
        "  COUNT(cncodpus) as pus_criticos,\n",
        "  ROUND(AVG(TRY_CAST(`SALDO DIAS` AS DOUBLE)), 1) as promedio_cobertura,\n",
        "  SUM(TRY_CAST(`SALDO ROLLOS` AS DOUBLE)) as stock_total\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "  AND TRY_CAST(`SALDO DIAS` AS DOUBLE) < 15\n",
        "GROUP BY\n",
        "  DEPARTAMENTO,\n",
        "  MUNICIPIO\n",
        "ORDER BY\n",
        "  pus_criticos DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "acciones_por_sede",
      "displayName": "Acciones por Sede de Distribución",
      "queryLines": [
        "SELECT\n",
        "  `SEDE ROLLOS` as sede,\n",
        "  `ACCIÓN` as accion,\n",
        "  COUNT(cncodpus) as cantidad_pus\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  `SEDE ROLLOS`,\n",
        "  `ACCIÓN`\n",
        "ORDER BY\n",
        "  `SEDE ROLLOS`"
      ]
    },
    {
      "name": "resumen_alertas",
      "displayName": "Resumen de Alertas por Nivel",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) < 7 THEN 'ROJA - Crítico'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) BETWEEN 7 AND 15 THEN 'NARANJA - Urgente'\n",
        "    WHEN TRY_CAST(`SALDO DIAS` AS DOUBLE) BETWEEN 15 AND 30 THEN 'AMARILLA - Atención'\n",
        "    ELSE 'VERDE - Normal'\n",
        "  END AS nivel_alerta,\n",
        "  COUNT(*) AS total_pus,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN `ACCIÓN` = 'REABASTECER' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS pus_reabastecer,\n",
        "  ROUND(AVG(TRY_CAST(`SALDO DIAS` AS DOUBLE)), 1) AS cobertura_promedio\n",
        "FROM\n",
        "  proyecto1.default.modelo_bigdata_raw\n",
        "WHERE\n",
        "  `ESTADO PUNTO` = 'ACTIVO'\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN nivel_alerta LIKE 'ROJA%' THEN 1\n",
        "    WHEN nivel_alerta LIKE 'NARANJA%' THEN 2\n",
        "    WHEN nivel_alerta LIKE 'AMARILLA%' THEN 3\n",
        "    ELSE 4\n",
        "  END"
      ]
    }
  ],
